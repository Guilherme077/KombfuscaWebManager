@using KombfuscaWebManager.Models.CupModels
@model IEnumerable<Participation>

@{
    ViewData["Title"] = "Pagamentos Pendentes";
    var paymentsCount = Model.Count();
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0" style="color: #333;">
                Pagamentos Pendentes
            </h1>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="card bg-primary text-white d-inline-block" style="min-width: 200px;">
                <div class="card-body p-3">
                    <small class="text-white-50">Pagamentos Pendentes</small>
                    <h3 class="mb-0 mt-1">@paymentsCount</h3>
                </div>
            </div>
        </div>
    </div>

    @if (paymentsCount == 0)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Não há pagamentos pendentes!</strong> Todos os pagamentos foram registrados.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%;"><i class="fas fa-trophy me-2"></i>Copa</th>
                                <th style="width: 20%;"><i class="fas fa-users me-2"></i>Time</th>
                                <th style="width: 20%;"><i class="fas fa-user me-2"></i>Participante</th>
                                <th style="width: 10%;"><i class="fas fa-user me-2"></i>Valor (R$)</th>
                                <th style="width: 20%;"><i class="fas fa-money-check me-2"></i>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var participation in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-info">@participation.Cup.Name</span>
                                    </td>
                                    <td>
                                        <strong>@participation.TeamName</strong>
                                    </td>
                                    <td>
                                        <small>@participation.User.FullName</small>
                                    </td>
                                    <td>
                                        <small>@participation.Cup.SubscriptionFee</small>
                                    </td>
                                    <td>
                                        <form asp-controller="Participations" asp-action="PaymentsControl" method="post" style="display:inline;" onsubmit="return confirm('Confirmar pagamento de @participation.TeamName?');">
                                            <input type="hidden" name="participationId" value="@participation.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-check me-1"></i>Confirmar Pagamento
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Aviso:</strong> A confirmação de pagamento não pode ser desfeita.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("AdminArea", "Home")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Voltar para a Área do Admin
        </a>
    </div>
</div>