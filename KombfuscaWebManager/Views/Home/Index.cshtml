@using KombfuscaWebManager.Models.CupModels;
@model IEnumerable<Cup>;
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Sistema Eletrônico do Kombfusca</h1>
</div>
<div>
    <a asp-area="Identity" asp-page="/Account/Login">Entrar com uma conta CAK</a>
</div>
@if(Model.Count() > 0)
{
    <div>
        <h3>Falta @((Model.First().StartDate - DateTime.Now).Days) dias para a @Model.First().Name!</h3>
    </div>
}
