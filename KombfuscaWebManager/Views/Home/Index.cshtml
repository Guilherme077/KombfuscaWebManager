@using KombfuscaWebManager.Models.CupModels;
@model IEnumerable<Cup>;
@{
    ViewData["Title"] = "Home";
}

<div class="bg-primary bg-gradient text-white text-center py-5 mb-4 rounded-3 shadow">
    <div class="container">
        <h1 class="display-4 fw-bold">Sistema Eletrônico do Kombfusca</h1>
        <p class="lead text-light">Gerenciador Web de Jogos do Kombfusca</p>
    </div>
</div>

<div class="container">

    <div class="d-flex justify-content-center mb-4">
        <a asp-area="Identity" asp-page="/Account/Login"
           class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-box-arrow-in-right me-2"></i>Entrar com uma conta CAK
        </a>
    </div>

    @if (Model.Count() > 0)
    {
        var cup = Model.First();
        var diasRestantes = (cup.StartDate - DateTime.Now).Days;

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-secondary-subtle shadow-sm">
                    <div class="card-body bg-light-subtle text-center py-4">
                        <h6 class="text-secondary text-uppercase mb-2">Próximo campeonato</h6>
                        <h3 class="text-primary-emphasis fw-semibold mb-3">@cup.Name</h3>
                        <span class="badge bg-secondary fs-5 px-3 py-2">
                            Falta@(diasRestantes == 1 ? "" : "m") @diasRestantes dia@(diasRestantes == 1 ? "" : "s")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

</div>