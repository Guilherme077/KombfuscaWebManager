@using KombfuscaWebManager.Controllers
@using KombfuscaWebManager.Models.AdModels
@using KombfuscaWebManager.Models.AdModels.ViewModels
@model AdCentralViewModel

@{
    ViewData["Title"] = "Central de anúncios"; var hasPeriod = Model.AdPeriodStatus != AdPeriodStatus.NoCupOrPeriodFound;
}
<link rel="stylesheet" href="~/css/ads.css" asp-append-version="true" />

<div class="ads-shell">
    <header class="ads-page-header"><h1 class="ads-title">Central de anúncios</h1><p class="ads-lead mb-0">Inscreva sua marca, acompanhe a análise e participe do leilão.</p></header>

    @if (hasPeriod && Model.AdPeriodStatus != AdPeriodStatus.AuctionEnded)
    {
        <p><strong>Cronograma</strong></p>
        <section class="ads-timeline ads-surface mb-4">
            <div class="ads-timeline__item"><span class="ads-timeline__label">01 · Inscrições</span><span class="ads-timeline__date">@Model.CurrentAdPeriod.StartSubscription.ToString("dd/MM/yyyy") — @Model.CurrentAdPeriod.EndSubscription.ToString("dd/MM/yyyy")</span></div>
            <div class="ads-timeline__item"><span class="ads-timeline__label">02 · Resultado da análise</span><span class="ads-timeline__date">@Model.CurrentAdPeriod.SituationReviewDate.ToString("dd/MM/yyyy")</span></div>
            <div class="ads-timeline__item"><span class="ads-timeline__label">03 · Leilão</span><span class="ads-timeline__date">@Model.CurrentAdPeriod.StartAuction.ToString("dd/MM/yyyy") — @Model.CurrentAdPeriod.EndAuction.ToString("dd/MM/yyyy")</span></div>
        </section>
    }

    @switch (Model.AdPeriodStatus)
    {
        case AdPeriodStatus.NoCupOrPeriodFound:
            <div class="ads-notice ads-notice--warning"><i class="bi bi-calendar-x"></i><div><strong>Nenhum programa de anúncios definido</strong><p>Aguarde a definição do cronograma de inscrições e leilão pela CAK</p></div></div>
            break;
        case AdPeriodStatus.WaitingSubscription:
            <div class="ads-notice"><i class="bi bi-clock"></i><div><strong>As inscrições começam em breve</strong><p>Consulte o cronograma acima.</p></div></div>
            break;
        case AdPeriodStatus.SubscriptionOpen:
            <div class="ads-notice ads-notice--success"><i class="bi bi-megaphone"></i><div><strong>Inscrições abertas</strong><p>Você pode cadastrar mais de uma instituição. Cada pedido será analisado e, quando aprovado, poderá participar do leilão. Uma inscrição pode ser cancelada até receber o primeiro lance.</p></div></div>
            <section class="ads-section"><div class="ads-section-heading"><div><h2>Modalidades de divulgação</h2><p>Confira as categorias de anúncios e seus requisitos</p></div></div>@await Html.PartialAsync("_AdCategories", Model.CurrentAdPeriod.Categories)<div class="ads-notice ads-notice--warning mt-3"><i class="bi bi-info-circle"></i><div><strong>Como a categoria é atribuída?</strong><p>Superar o valor mínimo torna o lance elegível, mas não garante a vaga. As posições são preenchidas pelos maiores lances, respeitando o limite de cada categoria.</p></div></div></section>
            <div class="row g-4 ads-section">
                <div class="col-lg-5"><section class="ads-surface ads-form"><div class="ads-section-heading"><div><h2>Inscrever uma marca</h2><p>Campos com * são obrigatórios.</p></div></div><form asp-action="CreateAdRequest" asp-controller="Ads" method="post"><div class="mb-3"><label class="form-label">Nome oficial *</label><input type="text" name="OficialName" class="form-control" required /></div><div class="mb-3"><label class="form-label">Nome da marca *</label><input type="text" name="BrandName" class="form-control" required /></div><div class="mb-4"><label class="form-label">Slogan</label><input type="text" name="Slogan" class="form-control" placeholder="Opcional" /></div><button type="submit" class="btn ads-btn-primary w-100">Enviar para análise</button></form></section></div>
                <div class="col-lg-7"><section><div class="ads-section-heading"><div><h2>Suas inscrições</h2><p>Acompanhe os pedidos enviados neste período.</p></div><span class="ads-count">@Model.UserAdRequest.Count()</span></div><div class="ads-table-wrap"><table class="table ads-table"><thead><tr><th>Marca</th><th>Enviada em</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var request in Model.UserAdRequest) {
                    <tr><td class="fw-semibold">@request.BrandName</td><td>@request.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="ads-status ads-status--pending">Em análise</span></td><td class="text-end"><a asp-action="DeleteAdRequest" asp-route-id="@request.Id" class="btn btn-sm btn-outline-danger">Cancelar</a></td></tr>
                }
                @if (!Model.UserAdRequest.Any())
                {
                    <tr><td colspan="4" class="ads-empty"><i class="bi bi-inbox"></i>Nenhuma inscrição enviada.</td></tr>
                }
            </tbody></table></div></section></div>
    </div>
    break;
        case AdPeriodStatus.WaitingResults:
        <div class="ads-notice"><i class="bi bi-hourglass-split"></i><div><strong>Inscrições encerradas</strong><p>Os pedidos estão sendo analizados. A data de publicação do resultado está no cronograma acima.</p></div></div>
        break;
    case AdPeriodStatus.ResultsAvailable:
        <div class="ads-notice ads-notice--success"><i class="bi bi-check2-circle"></i><div><strong>Resultado da análise disponível</strong><p>Confira abaixo a situação de cada marca. Pedidos aprovados poderão participar do leilão.</p></div></div>
        <section class="ads-section">
            <div class="ads-section-heading"><div><h2>Resultado das inscrições</h2></div></div><div class="ads-table-wrap"><table class="table ads-table"><thead><tr><th>Marca</th><th>Situação</th><th>Observação</th></tr></thead><tbody>@foreach (var request in Model.UserAdRequest) {
            <tr><td class="fw-semibold">@request.BrandName</td><td>@if (request.Status == RequestStatus.Approved) {
                <span class="ads-status ads-status--success">Aprovado</span>
            } else if (request.Status == RequestStatus.Rejected)
            {

                <span class="ads-status ads-status--danger">Rejeitado</span>
            }
            else
            {

                <span class="ads-status ads-status--pending">Em análise</span>
            }
        </td><td>@(String.IsNullOrWhiteSpace(request.StatusMessage) ? "—" : request.StatusMessage)</td></tr>
    }
</tbody></table></div>
        <div class="row g-3 mt-1"><div class="col-md-6"><div class="ads-notice ads-notice--success h-100 mb-0"><i class="bi bi-check-circle-fill"></i><div><strong>Se o pedido foi aprovado</strong><p>A marca pode participar do leilão. Ela será divulgada apenas se realizar um lance válido no período de leilão.</p></div></div></div><div class="col-md-6"><div class="ads-notice ads-notice--danger h-100 mb-0"><i class="bi bi-exclamation-triangle"></i><div><strong>Se o pedido foi rejeitado</strong><p>A decisão pode ser contestada pessoalmente com a CAK até 12 horas antes do leilão. Pedidos rejeitados não poderão fazer lances.</p></div></div></div></div>
</section>
            break;
        case AdPeriodStatus.AuctionOpen:
    <section class="ads-auction-hero mb-4"><span class="ads-live">Leilão aberto</span><h1>Dispute a categoria desejada</h1><p>Os valores são públicos durante a disputa. A identidade dos participantes permanece anônima até o encerramento.</p></section>
    <section class="ads-section"><div class="ads-section-heading"><div><h2>Categorias em disputa</h2><p>Os maiores lances ocupam primeiro as categorias de maior valor mínimo.</p></div></div>@await Html.PartialAsync("_AdCategories", Model.CurrentAdPeriod.Categories)</section>
    <div class="row g-4 ads-section">
        <div class="col-lg-8"><div class="ads-section-heading"><div><h2>Placar de lances</h2><p>Atualizado em @DateTime.Now.ToString("dd/MM/yyyy 'às' HH:mm:ss"). Recarregue a página para atualizar o placar.</p></div></div><div class="ads-table-wrap"><table class="table ads-table"><thead><tr><th>#</th><th>Marca</th><th class="text-end">Lance</th><th>Categoria Prevista</th></tr></thead><tbody>@{
            var rank = 0;
        }
        @foreach (var ad in Model.AllValidAuctionBids)
        {
            rank++; Model.BidCategories.TryGetValue(ad.Id, out var category);
            <tr><td class="ads-rank">@rank.ToString("00")</td><td class="fw-semibold">@ad.Request.BrandName</td><td class="text-end fw-bold">R$ @ad.Value.ToString("N2")</td><td><span class="ads-status @(category == null ? "ads-status--pending" : "ads-status--success")">@(category?.Name ?? "Fora da faixa")</span></td></tr>
        }
        @if (!Model.AllValidAuctionBids.Any())
        {
            <tr><td colspan="4" class="ads-empty"><i class="bi bi-hammer"></i>O placar está vazio. Faça o primeiro lance.</td></tr>
        }
                    </tbody>
                </table>
            </div><div class="ads-notice ads-notice--warning mt-3"><i class="bi bi-arrow-repeat"></i><div><strong>Classificação dinâmica</strong><p>A categoria prevista pode mudar conforme novos lances são feitos.</p></div></div><div class="ads-notice ads-notice--warning mt-3"><i class="bi bi-arrow-repeat"></i><div><strong>O placar NÃO é atualizado automáticamente</strong><p>Você precisa atualizar a página para ver a situação atual do placar.</p></div></div>
        </div>
    <div class="col-lg-4"><aside class="ads-surface ads-bid-panel"><div class="ads-bid-panel__header"><h2>Fazer Lance</h2><p>Confirme com atenção: lances são irreversíveis.</p></div><form asp-action="NewAuctionBid" asp-controller="Ads" method="post" class="ads-form"><div class="mb-3"><label class="form-label">Marca representada</label><select name="RequestId" class="form-select" required><option value="" selected disabled>Selecione uma instituição</option>@foreach (var request in Model.UserAdRequest) {
        <option value="@request.Id">@request.BrandName</option>
    }
</select></div><div class="mb-4"><label class="form-label">Valor do lance (USE VÍRGULA ',' como separador decimal)</label><div class="input-group"><span class="input-group-text">R$</span><input type="text" name="Value" class="form-control" inputmode="decimal" placeholder="0,00" required /></div></div><button type="submit" class="btn ads-btn-primary w-100"><i class="bi bi-hammer me-2"></i>Confirmar lance</button><div class="mt-4"><div class="ads-fieldset-title">Regras</div><ol class="ads-rules"><li>O lance não pode ser cancelado.</li><li>Um novo lance deve ser superior ao lance anterior (da mesma instituição).</li><li>Você pode aumentar seu lance durante o período de leilão.</li><li>Marca e valor serão públicos no resultado final.</li></ol></div></form></aside></div>
</div>
            break;
        case AdPeriodStatus.AuctionEnded:
    <div class="ads-notice"><i class="bi bi-flag"></i><div><strong>Leilão encerrado</strong><p>O ranking abaixo é definitivo e apresenta os valores e as categorias conquistadas.</p></div></div>
    <section class="ads-section"><div class="ads-section-heading"><div><h2>Categorias do período</h2></div></div>@await Html.PartialAsync("_AdCategories", Model.CurrentAdPeriod.Categories)</section>
    <section class="ads-section"><div class="ads-section-heading"><div><h2>Resultado final</h2><p>Classificação pública do leilão.</p></div></div><div class="ads-table-wrap"><table class="table ads-table"><thead><tr><th>#</th><th>Marca</th><th class="text-end">Valor final</th><th>Categoria</th></tr></thead><tbody>@{
        var finalRank = 0;
    }
    @foreach (var ad in Model.AllValidAuctionBids)
    {
        finalRank++; Model.BidCategories.TryGetValue(ad.Id, out var category);
        <tr><td class="ads-rank">@finalRank.ToString("00")</td><td class="fw-semibold">@ad.Request.BrandName</td><td class="text-end fw-bold">R$ @ad.Value.ToString("N2")</td><td>@(category?.Name ?? "Sem categoria")</td></tr>
    }
</tbody></table></div></section>
break;
default:
<div class="ads-notice ads-notice--warning"><i class="bi bi-exclamation-triangle"></i><div><strong>Período indisponível</strong><p>Não foi possível encontrar um período de anúncios ativo.</p></div></div>
            break;
    }
</div>
