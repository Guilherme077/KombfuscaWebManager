@using KombfuscaWebManager.Models.CertificateModels.ViewModels
@model CreateCertificateViewModel

@{
    ViewData["Title"] = "Emitir certificado";
}

<style>
    .certificate-page {
        --certificate-primary: #0d3c61;
        --certificate-accent: #c6a15b;
    }

    .certificate-header {
        position: relative;
        overflow: hidden;
        padding: 2rem;
        color: #fff;
        background: linear-gradient(135deg, #0d3c61 0%, #176b9b 100%);
        border-radius: 1rem;
        box-shadow: 0 0.75rem 2rem rgba(13, 60, 97, 0.18);
    }

    .certificate-header::after {
        position: absolute;
        right: -2rem;
        bottom: -4rem;
        font-family: "bootstrap-icons";
        font-size: 12rem;
        line-height: 1;
        color: rgba(255, 255, 255, 0.08);
        content: "\\f151";
        transform: rotate(-10deg);
    }

    .certificate-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 1.5rem rgba(15, 23, 42, 0.08);
    }

    .certificate-card .card-header {
        padding: 1.1rem 1.25rem;
        color: var(--certificate-primary);
        background: #fff;
        border-bottom: 1px solid #e8edf2;
        border-radius: 1rem 1rem 0 0;
        font-weight: 700;
    }

    .result-stat {
        height: 100%;
        padding: 1rem;
        text-align: center;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 0.75rem;
    }

    .result-stat strong {
        display: block;
        color: var(--certificate-primary);
        font-size: 1.65rem;
        line-height: 1.1;
    }

    .result-stat span {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .position-badge {
        display: inline-flex;
        width: 4rem;
        height: 4rem;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #c6a15b, #e0bd70);
        border-radius: 50%;
        box-shadow: 0 0.4rem 1rem rgba(198, 161, 91, 0.3);
        font-size: 1.25rem;
        font-weight: 800;
    }

    .form-control:focus {
        border-color: #5795ba;
        box-shadow: 0 0 0 0.2rem rgba(23, 107, 155, 0.12);
    }

    .readonly-field {
        color: #475569;
        background-color: #f1f5f9 !important;
    }

    .btn-certificate {
        color: #fff;
        background: var(--certificate-primary);
        border-color: var(--certificate-primary);
    }

    .btn-certificate:hover {
        color: #fff;
        background: #092d49;
        border-color: #092d49;
    }
</style>

<div class="container certificate-page py-4">
    <div class="certificate-header mb-4">
        <div class="position-relative" style="z-index: 1;">
            <div class="d-flex align-items-center gap-3 mb-2">
                <i class="bi bi-award-fill fs-1" style="color: #f0d38e;"></i>
                <div>
                    <h1 class="h2 fw-bold mb-1">Emitir certificado</h1>
                    <p class="mb-0 text-white-50">Revise as informações antes de registrar o certificado.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card certificate-card mb-4">
                <div class="card-header">
                    <i class="bi bi-person-badge me-2"></i>Participante
                </div>
                <div class="card-body text-center p-4">
                    <div class="position-badge mb-3">@(Model.cupResult?.Position)º</div>
                    <h2 class="h5 fw-bold mb-1" style="color: #0d3c61;">@Model.PlayerName</h2>
                    <p class="text-muted mb-3">@Model.CupName</p>
                    <span class="badge rounded-pill text-bg-light border px-3 py-2">
                        <i class="bi bi-people-fill me-1"></i>@(string.IsNullOrWhiteSpace(Model.cupResult?.TeamName) ? "Sem time" : Model.cupResult.TeamName)
                    </span>
                </div>
            </div>

            <div class="card certificate-card">
                <div class="card-header">
                    <i class="bi bi-bar-chart-fill me-2"></i>Resultado da copa
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <div class="result-stat" style="background: #eef7fc; border-color: #cfe7f5;">
                                <strong>@Model.cupResult?.TotalScore</strong>
                                <span>Pontos totais</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="result-stat">
                                <strong>@Model.cupResult?.QtdKombi</strong>
                                <span>Kombi</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="result-stat">
                                <strong>@Model.cupResult?.QtdFusca</strong>
                                <span>Fusca</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="result-stat">
                                <strong>@Model.cupResult?.QtdNewBeetle</strong>
                                <span>Beetle</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card certificate-card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-file-earmark-text me-2"></i>Conteúdo do certificado</span>
                    <span class="badge text-bg-light border fw-normal">Modelo padrão</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input asp-for="CupId" type="hidden" />
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="CertificateFileModel" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control form-control-lg" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                            <div class="form-text">Este texto será o destaque principal do PDF.</div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Description1" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description1" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description1" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Description2" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description2" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description2" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PlayerName" class="form-label fw-semibold">Nome no certificado</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="PlayerName" class="form-control readonly-field" readonly />
                            </div>
                            <div class="form-text">O nome é obtido do cadastro do participante.</div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">Data inicial</label>
                                <input asp-for="StartDate" type="date" class="form-control readonly-field" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">Data final</label>
                                <input asp-for="EndDate" type="date" class="form-control readonly-field" readonly />
                            </div>
                        </div>

                        <div class="alert alert-light border d-flex gap-3 align-items-start mb-4">
                            <i class="bi bi-shield-check fs-4 text-success"></i>
                            <div>
                                <strong class="d-block">Registro protegido</strong>
                                <small class="text-muted">Após a emissão, o participante poderá baixar o PDF e validar sua autenticidade pelo código exclusivo.</small>
                            </div>
                        </div>

                        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2 pt-2 border-top">
                            <a asp-controller="Score" asp-action="CupScores" asp-route-cupId="@Model.CupId" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Voltar aos resultados
                            </a>
                            <button type="submit" class="btn btn-certificate px-4">
                                <i class="bi bi-award-fill me-2"></i>Emitir certificado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
