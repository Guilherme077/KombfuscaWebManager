@model string

@{
    ViewData["Title"] = "Senha redefinida";
}

<h1>Senha redefinida</h1>

<div class="alert alert-warning">
    <strong>Nova senha temporária:</strong>
    <code>@Model</code>
</div>

<p>
    Entregue esta senha ao usuário e informe que ele deverá
    alterá-la após o primeiro login.
</p>