@using KombfuscaWebManager.Models.CupModels.ViewModels
@model List<MyScoreViewModel>

@{
    ViewData["Title"] = "Pontuações da Copa";
    var firstResult = Model.FirstOrDefault();
    var orderedScores = Model.OrderBy(m => m.Position).ToList();
}

<div class="container-fluid mt-5">
    <div class="row mb-5">
        <div class="col-12">
            <div style="padding-bottom: 1.5rem; border-bottom: 3px solid #3b82f6;">
                <h1 style="color: #1e3a8a; margin-bottom: 0.5rem;">
                    @firstResult?.CupName
                </h1>
                <small class="text-muted" style="font-size: 1rem;">
                    Ano: @firstResult?.CupYear
                </small>
            </div>
        </div>
    </div>

    @if (!orderedScores.Any())
    {
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Nenhum resultado disponível</strong> - Os resultados dessa copa ainda não foram publicados.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-left: 5px solid #3b82f6;">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr style="background-color: #f0f9ff; border-bottom: 2px solid #3b82f6;">
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; width: 10%;">
                                        Posição
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; width: 20%;">
                                        Time
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; width: 15%;">
                                        Competidor
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; text-align: center; width: 12%;">
                                        Pontos
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; text-align: center; width: 11%;">
                                        Kombi
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; text-align: center; width: 11%;">
                                        Fusca
                                    </th>
                                    <th style="color: #1e3a8a; padding: 1rem; font-weight: 600; text-align: center; width: 12%;">
                                        New Beetle
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var score in orderedScores)
                                {
                                    var positionColor = score.Position switch
                                    {
                                        1 => "#fbbf24", 
                                        2 => "#d1d5db",
                                        3 => "#d97706", 
                                        _ => "#e5e7eb"
                                    };

                                    var positionBgColor = score.Position switch
                                    {
                                        1 => "#FFFBAD",
                                        2 => "#C4C4C4",
                                        3 => "#D4BA7D",
                                        _ => "#f8fafc"
                                    };

                                    <tr style="background-color: @positionBgColor; border-bottom: 1px solid #e5e7eb; transition: all 0.2s;"
                                        onmouseover="this.style.backgroundColor='#dbeafe'; this.style.boxShadow='0 2px 4px rgba(59, 130, 246, 0.1)'"
                                        onmouseout="this.style.backgroundColor='@positionBgColor'; this.style.boxShadow='none'">

                                        <td style="padding: 1rem; vertical-align: middle;">
                                            <div style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: @positionColor; color: white; font-weight: bold; font-size: 1.1rem;">
                                                @score.Position
                                            </div>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle;">
                                            <strong style="color: #1e3a8a; font-size: 1rem;">@score.TeamName</strong>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle;">
                                            <small style="color: #64748b;">@score.UserName</small>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle; text-align: center;">
                                            <span style="display: inline-block; padding: 0.5rem 1rem; background-color: #3b82f6; color: white; border-radius: 6px; font-weight: bold; font-size: 1.1rem;">
                                                @score.TotalScore
                                            </span>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle; text-align: center;">
                                            <span style="display: inline-block; padding: 0.4rem 0.8rem; background-color: #f0f9ff; color: #0284c7; border-radius: 4px; border: 1px solid #bfdbfe; font-weight: 600;">
                                                @score.Kombi
                                            </span>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle; text-align: center;">
                                            <span style="display: inline-block; padding: 0.4rem 0.8rem; background-color: #f0fdf4; color: #16a34a; border-radius: 4px; border: 1px solid #bbf7d0; font-weight: 600;">
                                                @score.Fusca
                                            </span>
                                        </td>

                                        <td style="padding: 1rem; vertical-align: middle; text-align: center;">
                                            <span style="display: inline-block; padding: 0.4rem 0.8rem; background-color: #fef2f2; color: #dc2626; border-radius: 4px; border: 1px solid #fecaca; font-weight: 600;">
                                                @score.NewBeetle
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="alert alert-info" role="alert" style="background-color: #dbeafe; border-color: #93c5fd; color: #1e40af;">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Total de Participantes:</strong> @orderedScores.Count()
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-success" role="alert" style="background-color: #dcfce7; border-color: #bbf7d0; color: #166534;">
                        <i class="fas fa-trophy me-2"></i>
                        <strong>Vencedor:</strong> @(orderedScores.FirstOrDefault()?.TeamName ?? "N/A")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <a asp-action="MyScores" asp-controller="Score" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Voltar para Minhas Pontuações
            </a>
        </div>
    </div>
</div>