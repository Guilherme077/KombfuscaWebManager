@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Resetar chave do autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Resetar a chave do autenticador irá desativar a autenticação de 2 fatores até que você reconfigure o aplicativo.</strong>
    </p>
    <p>
        Esse processo desabilita a autenticação de dois fatores. VOCÊ PODE PERDER ACESSO A CONTA, se não tiver códigos de recuperação armazenados ou configurar outra forma de autenticação.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Redefinir Chave do Autenticador</button>
    </form>
</div>
